# Server
PORT=3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# AI provider: "local" (default, no API key needed) or "openai"
AI_PROVIDER=local

# External LLM policy flag (Requirement 15.5).
# When false, candidate/CV data is NEVER sent to an external provider,
# even if AI_PROVIDER=openai.
ALLOW_EXTERNAL_LLM=false

# Only used when AI_PROVIDER=openai AND ALLOW_EXTERNAL_LLM=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
