# ---- Shared root environment example ----
# Copy to .env in backend/ and frontend/ as needed.
NODE_ENV=development

# ---- Backend: API server ----
API_PORT=3000
API_HOST=0.0.0.0
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- Database (PostgreSQL) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=career
DATABASE_PASSWORD=career
DATABASE_NAME=ai_career_platform

# ---- Object storage (S3-compatible, e.g. MinIO/AWS S3) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cv-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SERVER_SIDE_ENCRYPTION=AES256

# ---- AI provider (gated by external-use policy flag, Req 15.5) ----
AI_EXTERNAL_PROVIDER_ENABLED=false
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# ---- Frontend (Vite; must be prefixed VITE_) ----
VITE_API_BASE_URL=http://localhost:3000
VITE_DEFAULT_LOCALE=en
